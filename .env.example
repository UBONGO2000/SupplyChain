# Environment Configuration
# ========================
# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_URL=mysql+pymysql://username:password@host:port/database_name
# Enable TLS towards MySQL/TiDB (set false for a local MySQL without TLS)
DB_SSL=true

# Security
# REQUIRED, 32 characters minimum. The application refuses to start without it.
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# JWT Token Expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# First administrator (optional, created once at startup when both are set)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_USERNAME=

# Application
APP_ENV=development
# Load demo data at startup - keep false in production
SEED_DEMO_DATA=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional regex for preview deployments, e.g. ^https://my-app-.*\.vercel\.app$
# Leave empty to reject every unlisted origin.
CORS_ORIGIN_REGEX=
